# The API port is optional and defaults to 5000.
PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
CLIENT_ORIGINS=http://localhost:5173

# CognoDB values will be used when the database connection is added in Step 3.
DATABASE_URI=bolt+s://your-instance.databases.cognodb.cloud
DATABASE_USERNAME=cognodb
DATABASE_PASSWORD=replace-with-your-password
